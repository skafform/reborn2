{
  "name": "skafform-console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "vite preview",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "api:fetch": "node --env-file=.env scripts/fetch-spec.ts",
    "api:generate": "orval",
    "api:sync": "pnpm api:fetch && pnpm api:generate && pnpm format"
  },
  "dependencies": {
    "better-auth": "^1.7.1",
    "isbot": "^5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@react-router/dev": "^8.3.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "orval": "^8.24.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
