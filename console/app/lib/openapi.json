            "description": "Créée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedApiKey"
                }
              }
            }
          }
        }
      }
    },
    "/api/organizations/{organizationId}/projects/{projectId}/api-keys/{apiKeyId}/revoke": {
      "post": {
        "summary": "Révoquer une clé API",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "organizationId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "projectId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "apiKeyId",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Révoquée"
          }
        }
