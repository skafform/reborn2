            "description": "Changé"
          }
        }
      }
    },
    "/api/organizations/{organizationId}/projects/{projectId}/api-keys": {
      "get": {
        "summary": "Les clés API d'un projet",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
