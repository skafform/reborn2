# Où le proxy du serveur de développement renvoie `/api`.
#
# Développement uniquement : en production la console est servie en statique,
# sans proxy, et joint l'API par son adresse publique (docs/backlog #0004).
#
# Pas de préfixe `VITE_` : cette valeur ne doit pas partir dans le bundle.
API_PROXY_TARGET=http://localhost:3000
