NODE_ENV=development
PORT=3000
# L'adresse où vont les humains — la console, pas le backend. Sert à composer
# les liens envoyés par email (confirmation d'invitation).
PLATFORM_URL=http://localhost:5173

# Rôle applicatif : ni superuser, ni propriétaire des tables -> soumis aux RLS.
DATABASE_URL=postgresql://skafform_app:CHANGEME@127.0.0.1:5433/skafform
# Rôle propriétaire du schéma : réservé aux migrations.
DATABASE_MIGRATION_URL=postgresql://skafform_owner:CHANGEME@127.0.0.1:5433/skafform

# Au moins 32 caractères, forte entropie :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Origines autorisées à ouvrir une session, en plus de BETTER_AUTH_URL.
# Séparées par des virgules. Vide = aucune autre origine admise.
# En développement : l'interface d'administration, servie par Vite.
TRUSTED_ORIGINS=http://localhost:5173

# Envoi d'emails transactionnels (invitations, magic link, réinitialisation).
RESEND_API_KEY=
PLATFORM_MAIL_FROM=noreply@example.com

# Utilisées uniquement par scripts/bootstrap-db.ts, jamais par le serveur.
# Connexion administrateur, requise une seule fois par environnement.
DATABASE_ADMIN_URL=
DATABASE_OWNER_PASSWORD=
DATABASE_APP_PASSWORD=
